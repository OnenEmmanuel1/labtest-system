<%- include('../partials/head') %>
<%- include('../partials/sidebar', { currentPath: '/admin/catalog' }) %>
<%- include('../partials/navbar', { pageTitle: test ? 'Edit Test' : 'Add Test' }) %>

<main class="labtm-main">
  <div class="labtm-content">
    <%- include('../partials/flash') %>

    <div class="labtm-breadcrumb">
      <a href="/admin/catalog">Test Catalog</a>
      <span class="labtm-breadcrumb-sep">/</span>
      <span><%= test ? 'Edit Test' : 'Add New Test' %></span>
    </div>

    <div class="labtm-page-header">
      <div>
        <h1><%= test ? 'Edit Test' : 'Add New Test' %></h1>
        <p><%= test ? `Editing: ${test.test_name}` : 'Add a new test to the catalog with reference ranges.' %></p>
      </div>
    </div>

    <div class="labtm-card" style="max-width:700px">
      <form method="POST" action="<%= test ? `/admin/catalog/${test.id}/edit` : '/admin/catalog' %>">

        <div class="labtm-form-row">
          <div class="labtm-form-group">
            <label class="labtm-label" for="test_name">Test Name <span class="required">*</span></label>
            <input class="labtm-input" type="text" id="test_name" name="test_name"
                   value="<%= test ? test.test_name : '' %>" required placeholder="e.g. Full Blood Count (FBC)" />
          </div>
          <div class="labtm-form-group">
            <label class="labtm-label" for="department_id">Department <span class="required">*</span></label>
            <select class="labtm-select" id="department_id" name="department_id" required>
              <option value="">Select department…</option>
              <% for (const dept of departments) { %>
              <option value="<%= dept.id %>" <%= test && test.department_id == dept.id ? 'selected' : '' %>>
                <%= dept.name %>
              </option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="labtm-form-group">
          <label class="labtm-label" for="description">Description</label>
          <textarea class="labtm-textarea" id="description" name="description" placeholder="Brief clinical description of this test…"><%= test ? test.description || '' : '' %></textarea>
        </div>

        <div class="labtm-form-row">
          <div class="labtm-form-group">
            <label class="labtm-label" for="reference_low">Reference Range — Low</label>
            <input class="labtm-input" type="number" step="any" id="reference_low" name="reference_low"
                   value="<%= test && test.reference_low !== null ? parseFloat(test.reference_low) : '' %>"
                   placeholder="e.g. 4.0" />
            <div class="labtm-form-hint">Numeric lower bound. Leave blank for qualitative tests.</div>
          </div>
          <div class="labtm-form-group">
            <label class="labtm-label" for="reference_high">Reference Range — High</label>
            <input class="labtm-input" type="number" step="any" id="reference_high" name="reference_high"
                   value="<%= test && test.reference_high !== null ? parseFloat(test.reference_high) : '' %>"
                   placeholder="e.g. 11.0" />
          </div>
        </div>

        <div class="labtm-form-row">
          <div class="labtm-form-group">
            <label class="labtm-label" for="unit">Unit</label>
            <input class="labtm-input" type="text" id="unit" name="unit"
                   value="<%= test ? test.unit || '' : '' %>" placeholder="e.g. g/dL, mmol/L, cells/µL" />
          </div>
          <div class="labtm-form-group">
            <label class="labtm-label" for="price">Price (₦) <span class="required">*</span></label>
            <input class="labtm-input" type="number" step="0.01" min="0" id="price" name="price"
                   value="<%= test ? parseFloat(test.price) : 0 %>" required />
          </div>
          <div class="labtm-form-group">
            <label class="labtm-label" for="turnaround_time_hours">TAT (hours) <span class="required">*</span></label>
            <input class="labtm-input" type="number" min="1" id="turnaround_time_hours" name="turnaround_time_hours"
                   value="<%= test ? test.turnaround_time_hours : 24 %>" required />
            <div class="labtm-form-hint">Expected turnaround time in hours.</div>
          </div>
        </div>

        <% if (test) { %>
        <div class="labtm-form-group">
          <label class="labtm-label labtm-flex labtm-flex-gap-2" style="cursor:pointer">
            <input type="checkbox" name="is_active" value="1" <%= test.is_active ? 'checked' : '' %> />
            Active (uncheck to deactivate this test)
          </label>
        </div>
        <% } %>

        <div class="labtm-flex labtm-flex-gap-3 labtm-mt-4">
          <button type="submit" class="labtm-btn labtm-btn-primary">
            <%= test ? 'Save Changes' : 'Add to Catalog' %>
          </button>
          <a href="/admin/catalog" class="labtm-btn labtm-btn-ghost">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
