<%- include('../partials/head') %>
<%- include('../partials/sidebar', { currentPath: '/technician/results' }) %>
<%- include('../partials/navbar', { pageTitle: 'Enter Result' }) %>

<main class="labtm-main">
  <div class="labtm-content">
    <%- include('../partials/flash') %>

    <div class="labtm-breadcrumb">
      <a href="/technician/results">Results</a>
      <span class="labtm-breadcrumb-sep">/</span>
      <span>Enter Result</span>
    </div>

    <div class="labtm-page-header">
      <div>
        <h1>Enter Result — <%= item.test_name %></h1>
        <p>Sample: <code class="labtm-code"><%= item.sample_code %></code></p>
      </div>
    </div>

    <!-- Context -->
    <div class="labtm-card labtm-mb-6">
      <div class="labtm-card-title labtm-mb-4">Test & Patient Context</div>
      <div class="labtm-detail-grid">
        <div class="labtm-detail-item">
          <div class="labtm-detail-label">Patient</div>
          <div class="labtm-detail-value labtm-font-bold"><%= item.patient_name %></div>
        </div>
        <div class="labtm-detail-item">
          <div class="labtm-detail-label">Patient ID</div>
          <div class="labtm-detail-value"><code class="labtm-code"><%= item.patient_unique_id %></code></div>
        </div>
        <div class="labtm-detail-item">
          <div class="labtm-detail-label">DOB</div>
          <div class="labtm-detail-value"><%= new Date(item.date_of_birth).toLocaleDateString('en-GB') %></div>
        </div>
        <div class="labtm-detail-item">
          <div class="labtm-detail-label">Gender</div>
          <div class="labtm-detail-value" style="text-transform:capitalize"><%= item.gender %></div>
        </div>
        <div class="labtm-detail-item">
          <div class="labtm-detail-label">Test Name</div>
          <div class="labtm-detail-value labtm-font-semibold"><%= item.test_name %></div>
        </div>
        <div class="labtm-detail-item">
          <div class="labtm-detail-label">Unit</div>
          <div class="labtm-detail-value"><%= item.unit || 'N/A' %></div>
        </div>
        <% if (item.reference_low !== null) { %>
        <div class="labtm-detail-item">
          <div class="labtm-detail-label">Reference Range</div>
          <div class="labtm-detail-value labtm-font-mono">
            <%= parseFloat(item.reference_low) %> – <%= parseFloat(item.reference_high) %> <%= item.unit %>
          </div>
        </div>
        <% } %>
        <div class="labtm-detail-item">
          <div class="labtm-detail-label">Sample Type</div>
          <div class="labtm-detail-value"><%= item.sample_type %></div>
        </div>
        <div class="labtm-detail-item">
          <div class="labtm-detail-label">Collected</div>
          <div class="labtm-detail-value"><%= new Date(item.collected_at).toLocaleString('en-GB') %></div>
        </div>
      </div>

      <% if (item.description) { %>
      <div class="labtm-alert labtm-alert-info labtm-mt-4">
        <div><strong>Test Description:</strong> <%= item.description %></div>
      </div>
      <% } %>
    </div>

    <!-- Existing result warning -->
    <% if (existing) { %>
    <div class="labtm-alert labtm-alert-warning labtm-mb-6">
      <div>
        <strong>Existing Result Found:</strong>
        Current value is <strong><%= existing.result_value %> <%= item.unit || '' %></strong>.
        Submitting this form will overwrite it.
        This result has <strong>NOT</strong> been verified yet, so editing is permitted.
      </div>
    </div>
    <% } %>

    <!-- Result entry form -->
    <div class="labtm-card" style="max-width:500px">
      <div class="labtm-card-title labtm-mb-4"><%= existing ? 'Update Result' : 'Enter Result' %></div>

      <form method="POST" action="/technician/results/<%= item.id %>/enter">

        <div class="labtm-form-group">
          <label class="labtm-label" for="result_value">
            Result Value
            <% if (item.unit) { %><span class="labtm-text-muted">(in <%= item.unit %>)</span><% } %>
            <span class="required">*</span>
          </label>
          <input class="labtm-input" type="text" id="result_value" name="result_value"
                 value="<%= existing ? existing.result_value : '' %>"
                 required placeholder="<%= item.unit ? 'e.g. 12.5' : 'e.g. Positive / Negative / value' %>"
                 style="font-size:var(--labtm-fs-lg);font-weight:600;font-family:monospace" />
          <% if (item.reference_low !== null) { %>
          <div class="labtm-form-hint">
            Reference: <%= parseFloat(item.reference_low) %> – <%= parseFloat(item.reference_high) %> <%= item.unit %>.
            Flagging is computed automatically.
          </div>
          <% } else { %>
          <div class="labtm-form-hint">
            Qualitative test — no automatic flagging. Enter exactly as measured.
          </div>
          <% } %>
        </div>

        <div class="labtm-form-group">
          <label class="labtm-label" for="notes">Additional Notes</label>
          <textarea class="labtm-textarea" id="notes" name="notes"
                    placeholder="Instrument ID, QC notes, clinical comments…"><%= existing ? existing.notes || '' : '' %></textarea>
        </div>

        <div class="labtm-alert labtm-alert-info labtm-mb-4">
          <div>
            After saving, this result will appear in the <strong>Verify Results</strong> queue.
            It is not locked until you verify it.
          </div>
        </div>

        <div class="labtm-flex labtm-flex-gap-3">
          <button type="submit" class="labtm-btn labtm-btn-primary labtm-btn-lg">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <%= existing ? 'Update Result' : 'Save Result' %>
          </button>
          <a href="/technician/results" class="labtm-btn labtm-btn-ghost labtm-btn-lg">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
