<%- include('../partials/head') %>
<%- include('../partials/sidebar', { currentPath: '/doctor/patients' }) %>
<%- include('../partials/navbar', { pageTitle: 'Patients' }) %>

<main class="labtm-main">
  <div class="labtm-content">
    <%- include('../partials/flash') %>

    <div class="labtm-page-header">
      <div>
        <h1>Patients</h1>
        <p>Search and manage patient records, or register a new patient.</p>
      </div>
      <div class="labtm-page-header-actions">
        <a href="/doctor/patients/new" class="labtm-btn labtm-btn-primary">
          <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Register Patient
        </a>
      </div>
    </div>

    <!-- Search -->
    <div class="labtm-card labtm-mb-6">
      <form method="GET" action="/doctor/patients" class="labtm-search-bar" style="max-width:100%">
        <input class="labtm-input" type="text" name="q" value="<%= search %>"
               placeholder="Search name, phone, or patient ID…" />
        <button type="submit" class="labtm-btn labtm-btn-primary">Search</button>
        <% if (search) { %><a href="/doctor/patients" class="labtm-btn labtm-btn-ghost">Clear</a><% } %>
      </form>
    </div>

    <div class="labtm-card">
      <div class="labtm-card-header">
        <div class="labtm-card-title">Patient Records</div>
        <div class="labtm-card-subtitle labtm-mt-2"><%= patients.length %> result<%= patients.length !== 1 ? 's' : '' %></div>
      </div>

      <div class="labtm-table-wrap">
        <table class="labtm-table">
          <thead>
            <tr>
              <th>Patient ID</th>
              <th>Name</th>
              <th>DOB</th>
              <th>Gender</th>
              <th>Phone</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!patients.length) { %>
            <tr><td colspan="6" class="labtm-table-empty">
              No patients found. <a href="/doctor/patients/new">Register a new patient →</a>
            </td></tr>
            <% } %>
            <% for (const p of patients) { %>
            <tr>
              <td><code class="labtm-code"><%= p.patient_unique_id %></code></td>
              <td class="labtm-font-semibold"><%= p.name %></td>
              <td class="labtm-text-sm"><%= new Date(p.date_of_birth).toLocaleDateString('en-GB') %></td>
              <td class="labtm-text-sm" style="text-transform:capitalize"><%= p.gender %></td>
              <td class="labtm-text-sm"><%= p.phone || '—' %></td>
              <td>
                <div class="labtm-flex labtm-flex-gap-2">
                  <a href="/doctor/patients/<%= p.id %>" class="labtm-btn labtm-btn-outline labtm-btn-sm">View</a>
                  <a href="/doctor/orders/new?patient_id=<%= p.id %>" class="labtm-btn labtm-btn-accent labtm-btn-sm">New Order</a>
                </div>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
